    "config": "5.0.1",
    "json-rules-engine": "7.3.1",
    "lazy-ass": "2.0.3",
    "lodash": "4.18.1",
    "mustache": "4.2.0",
    "nodemailer": "10.0.10",
    "rxjs": "7.8.2",
    "rxjs-compat": "6.6.7",
    "uuid4": "2.0.3"
